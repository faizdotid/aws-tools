/* AWS Tools TUI Stylesheet */

Screen {
    background: $surface-darken-1;
    color: $text;
}

#main-layout {
    height: 1fr;
    width: 100%;
}

#content-area {
    width: 1fr;
    height: 100%;
    padding: 0;
}

/* Scrollbars */
Scrollbar {
    background: $surface-darken-2;
    color: $primary;
}

/* TabbedContent */
TabbedContent {
    height: 100%;
}

TabPane {
    padding: 0;
    height: 100%;
}

/* Buttons */
Button {
    background: $primary-darken-2;
    color: $text;
}

Button:hover {
    background: $primary;
}

Button:focus {
    background: $primary-lighten-1;
}

/* DataTable */
DataTable {
    background: $surface;
    color: $text;
}

DataTable > .datatable--cursor {
    background: $primary-darken-2;
}

DataTable > .datatable--hover {
    background: $primary-darken-3;
}

/* Tree */
Tree {
    background: $surface;
    color: $text;
}

Tree > .tree--cursor {
    background: $primary-darken-2;
}

Tree > .tree--highlight {
    background: $primary-darken-3;
}

/* Input */
Input {
    background: $surface;
    color: $text;
    border: solid $primary-darken-2;
}

Input:focus {
    border: solid $primary;
}

/* Select */
Select {
    background: $surface;
    color: $text;
    border: solid $primary-darken-2;
}

Select:focus {
    border: solid $primary;
}

/* Notifications */
$notification-opacity: 0.95;
